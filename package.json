{
  "name": "mowcodegamingbot-y",
  "version": "0.1.0",
  "type": "module",
  "main": "main.js",
  "description": "MowCode Gaming Bot, remade — a discord.js bot with Postgres via Sequelize. A rewrite of the 2021-2024 Python/discord.py original, not a translation. No HTTP surface: a dashboard, if wanted, is a separate project.",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "db:migrate": "node database/scripts/migrate.js",
    "bot:register": "node scripts/register-commands.js",
    "test": "node test/pipeline/test-all.mjs",
    "test:unit": "node test/pipeline/test-all.mjs --unit-only",
    "db:seed": "node database/scripts/seed.js",
    "dev:animation": "node -e \"import('./app/data/fishing.js').then(m=>{for(let i=0;i<3;i++)console.log(m.animationFrame())})\""
  },
  "keywords": [
    "discord",
    "discord.js",
    "postgres",
    "sequelize"
  ],
  "author": "Ote (OteEnded)",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.3.0",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.23.0",
    "prism-media": "^1.3.5",
    "sequelize": "^6.37.8"
  }
}
